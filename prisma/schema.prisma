model School {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  status             SchoolStatus   @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  code               String?        @unique
  attendanceMinPct   Float?         @default(75)
  emailNotifications Boolean        @default(true)
  foundedYear        Int?
  lateFeePercent     Float?         @default(0)
  maxAbsenceAlert    Int?           @default(3)
  periodDurationMin  Int?           @default(45)
  periodsPerDay      Int?           @default(8)
  primaryColor       String?        @default("#2563eb")
  principalName      String?
  receiptPrefix      String?        @default("RCP")
  showRankInResult   Boolean        @default(true)
  smsNotifications   Boolean        @default(false)
  tagline            String?
  timezone           String?        @default("Asia/Kolkata")
  workingDays        String?        @default("MON,TUE,WED,THU,FRI")
  website            String?
  academicYears      AcademicYear[]
  announcements      Announcement[]
  attendance         Attendance[]
  classes            Class[]
  exams              Exam[]
  feeCategories      FeeCategory[]
  feePayments        FeePayment[]
  feeStructures      FeeStructure[]
  holidays           Holiday[]
  notifications      Notification[]
  periods            Period[]
  // ptmSlots           PtmSlot[]
  results            Result[]
  schoolEvents       SchoolEvent[]
  sections           Section[]
  subjects           Subject[]
  users              User[]

  @@map("schools")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String?
  link      String?
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([schoolId])
  @@map("notifications")
}

model AcademicYear {
  id             String                  @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean                 @default(false)
  isClosed       Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  schoolId       String
  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendance     Attendance[]
  exams          Exam[]
  feeStructures  FeeStructure[]
  periods        Period[]
  studentRecords StudentAcademicRecord[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  role                Role
  gender              Gender?
  phone               String?
  avatarUrl           String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  schoolId            String?
  loginId             String?              @unique
  markedAttendances   Attendance[]         @relation("AttendanceMarkedBy")
  createdExams        Exam[]               @relation("ExamCreatedBy")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  createdSchoolEvents SchoolEvent[]        @relation("CreatedSchoolEvents")
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId], map: "users_schoolId_fkey")
  @@map("users")
}

model TeacherProfile {
  id             String           @id @default(cuid())
  employeeCode   String?
  qualification  String?
  joiningDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String           @unique
  periods        Period[]
  // ptmSlots       PtmSlot[]
  classTeacherOf Section[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects       TeacherSubject[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id              String                  @id @default(cuid())
  rollNumber      String?
  admissionNo     String?
  dateOfBirth     DateTime?
  bloodGroup      String?
  address         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  userId          String                  @unique
  sectionId       String?
  attendance      Attendance[]
  feePayments     FeePayment[]
//  ptmMeetings     PtmMeeting[]
  results         Result[]
  academicRecords StudentAcademicRecord[]
  section         Section?                @relation(fields: [sectionId], references: [id])
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, rollNumber])
  @@map("student_profiles")
}

model StudentAcademicRecord {
  id               String                @id @default(cuid())
  rollNumber       String?
  loginId          String?
  isCurrent        Boolean               @default(false)
  status           StudentAcademicStatus @default(ACTIVE)
  promotedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  studentProfileId String
  academicYearId   String
  classId          String
  sectionId        String
  academicYear     AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class            Class                 @relation(fields: [classId], references: [id], onDelete: NoAction)
  section          Section               @relation(fields: [sectionId], references: [id], onDelete: NoAction)
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, academicYearId])
  @@unique([academicYearId, sectionId, rollNumber])
  @@index([studentProfileId, isCurrent])
  @@index([academicYearId, classId, sectionId])
  @@index([classId], map: "student_academic_records_classId_fkey")
  @@index([sectionId], map: "student_academic_records_sectionId_fkey")
  @@map("student_academic_records")
}

model Class {
  id             String                  @id @default(cuid())
  name           String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  schoolId       String
  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams          Exam[]
  feeStructures  FeeStructure[]
  sections       Section[]
  studentRecords StudentAcademicRecord[]
  subjects       Subject[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Section {
  id             String                  @id @default(cuid())
  name           String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  schoolId       String
  classId        String
  classTeacherId String?
  attendance     Attendance[]
  periods        Period[]
  class          Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher   TeacherProfile?         @relation(fields: [classTeacherId], references: [id])
  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentRecords StudentAcademicRecord[]
  students       StudentProfile[]

  @@unique([classId, name])
  @@index([classTeacherId], map: "sections_classTeacherId_fkey")
  @@index([schoolId], map: "sections_schoolId_fkey")
  @@map("sections")
}

model Subject {
  id        String           @id @default(cuid())
  name      String
  code      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schoolId  String
  classId   String
  periods   Period[]
  results   Result[]
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers  TeacherSubject[]

  @@unique([schoolId, classId, name])
  @@index([classId], map: "subjects_classId_fkey")
  @@map("subjects")
}

model TeacherSubject {
  id               String         @id @default(cuid())
  teacherProfileId String
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, subjectId])
  @@index([subjectId], map: "teacher_subjects_subjectId_fkey")
  @@map("teacher_subjects")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId], map: "announcements_schoolId_fkey")
  @@map("announcements")
}

model Attendance {
  id               String           @id @default(cuid())
  date             DateTime         @db.Date
  status           AttendanceStatus @default(PRESENT)
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  schoolId         String
  studentProfileId String
  sectionId        String
  markedById       String
  academicYearId   String?
  academicYear     AcademicYear?    @relation(fields: [academicYearId], references: [id])
  markedBy         User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: NoAction)
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, date])
  @@index([sectionId, date])
  @@index([schoolId, date])
  @@index([studentProfileId])
  @@index([markedById])
  @@index([schoolId, academicYearId])
  @@index([academicYearId], map: "attendance_academicYearId_fkey")
  @@map("attendance")
}

model Exam {
  id             String        @id @default(cuid())
  name           String
  examType       ExamType      @default(OTHER)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  schoolId       String
  classId        String
  createdById    String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results        Result[]

  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([schoolId, examType])
  @@index([schoolId, academicYearId])
  @@index([academicYearId], map: "exams_academicYearId_fkey")
  @@index([classId], map: "exams_classId_fkey")
  @@index([createdById], map: "exams_createdById_fkey")
  @@map("exams")
}

model Result {
  id               String         @id @default(cuid())
  marksObtained    Float
  maxMarks         Float          @default(100)
  grade            String?
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  schoolId         String
  examId           String
  studentProfileId String
  subjectId        String
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentProfileId, subjectId])
  @@index([examId])
  @@index([studentProfileId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([schoolId, studentProfileId])
  @@map("results")
}

model Period {
  id               String          @id @default(cuid())
  dayOfWeek        DayOfWeek
  periodNumber     Int
  startTime        String?
  endTime          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  schoolId         String
  sectionId        String
  subjectId        String?
  teacherProfileId String?
  academicYearId   String?
  academicYear     AcademicYear?   @relation(fields: [academicYearId], references: [id])
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section          Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id])

  @@unique([sectionId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@index([sectionId])
  @@index([teacherProfileId])
  @@index([sectionId, academicYearId])
  @@index([academicYearId], map: "periods_academicYearId_fkey")
  @@index([subjectId], map: "periods_subjectId_fkey")
  @@map("periods")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model FeeCategory {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_categories")
}

model FeeStructure {
  id             String        @id @default(cuid())
  amount         Float
  dueDate        DateTime?
  academicYear   String
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  schoolId       String
  feeCategoryId  String
  classId        String?
  academicYearId String?
  payments       FeePayment[]
  yearLink       AcademicYear? @relation(fields: [academicYearId], references: [id])
  class          Class?        @relation(fields: [classId], references: [id])
  feeCategory    FeeCategory   @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYear])
  @@index([schoolId, feeCategoryId])
  @@index([schoolId, classId])
  @@index([schoolId, academicYearId])
  @@index([academicYearId], map: "fee_structures_academicYearId_fkey")
  @@index([classId], map: "fee_structures_classId_fkey")
  @@index([feeCategoryId], map: "fee_structures_feeCategoryId_fkey")
  @@map("fee_structures")
}

model FeePayment {
  id               String         @id @default(cuid())
  amountPaid       Float          @default(0)
  waivedAmount     Float          @default(0)
  paymentDate      DateTime?
  paymentMode      PaymentMode    @default(CASH)
  status           PaymentStatus  @default(PENDING)
  transactionRef   String?
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  schoolId         String
  studentProfileId String
  feeStructureId   String
  feeStructure     FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, feeStructureId])
  @@index([schoolId])
  @@index([studentProfileId])
  @@index([feeStructureId])
  @@index([schoolId, status])
  @@index([schoolId, paymentDate])
  @@map("fee_payments")
}

model SchoolEvent {
  id          String          @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean         @default(true)
  startTime   String?
  endTime     String?
  type        SchoolEventType @default(EVENT)
  color       String?         @default("#059669")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  schoolId    String
  createdById String
  createdBy   User            @relation("CreatedSchoolEvents", fields: [createdById], references: [id], onDelete: NoAction)
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, startDate])
  @@index([createdById], map: "school_events_createdById_fkey")
  @@map("school_events")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum HolidayType {
  PUBLIC
  SCHOOL
  EVENT
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// enum PtmStatus {
//  SCHEDULED
//  COMPLETED
//  CANCELLED
// }

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum ExamType {
  UNIT_TEST
  MID_TERM
  FINAL
  ASSIGNMENT
  PRACTICAL
  OTHER
}

enum SchoolEventType {
  EVENT
  SPORTS
  CULTURAL
  MEETING
  CELEBRATION
  LEAVE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

enum StudentAcademicStatus {
  ACTIVE
  PROMOTION_PENDING
  PROMOTED
  PASSED_OUT
  LEFT_SCHOOL
}
