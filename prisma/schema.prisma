generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  entityName String?
  metadata   String?  @db.LongText
  createdAt  DateTime @default(now())
  userId     String
  userRole   String
  userName   String
  schoolId   String?
  schoolName String?

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime    @db.Date
  type        HolidayType @default(SCHOOL)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId, date])
  @@map("holidays")
}

